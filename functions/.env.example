# Release tooling requires project-specific ignored dotenv files; see docs/releases.md.
# The example is documentation only. No generic functions/.env should be deployed.
# Cloud only: IAM database authentication, no database password.
STAFF_SQL_INSTANCE=mtl-service-e3e0c:northamerica-northeast1:mtl-restaurant-dev
STAFF_SQL_USER=YOUR_FUNCTION_SERVICE_ACCOUNT_WITHOUT_GSERVICEACCOUNT_COM
STAFF_SQL_DATABASE=restaurant
STAFF_RUNTIME_SERVICE_ACCOUNT=YOUR_FUNCTION_SERVICE_ACCOUNT_EMAIL
# Local emulator tests only; set these in the shell (never use cloud credentials):
# GCLOUD_PROJECT=demo-mtl
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# STAFF_LOCAL_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/restaurant

# Native order creation (dedicated runtime identity; trusted setup uses separate grants).
ORDERS_SQL_INSTANCE=your-project:northamerica-northeast1:your-instance
ORDERS_SQL_DATABASE=restaurant
ORDERS_SQL_USER=your-orders-runtime-iam-login
ORDERS_RUNTIME_SERVICE_ACCOUNT=orders-runtime@your-project.iam.gserviceaccount.com
# Never set ORDERS_LOCAL_DATABASE_URL in cloud deployment configuration.

# Per-topic endpoint regions; production uses northamerica-northeast2.
STAFF_REGION=northamerica-northeast1
ORDERS_REGION=northamerica-northeast1

# Admin Report callable. Use a distinct Cloud SQL IAM database identity.
REPORT_SQL_INSTANCE=project:region:instance
REPORT_SQL_USER=mtl-report-functions@project.iam
REPORT_SQL_DATABASE=restaurant
REPORT_RUNTIME_SERVICE_ACCOUNT=mtl-report-functions@project.iam.gserviceaccount.com
REPORT_REGION=northamerica-northeast1

# Admin order slip task runtime and provider. Store only the Secret Manager name here.
SLIPS_RUNTIME_SERVICE_ACCOUNT=mtl-slips-functions@your-project.iam.gserviceaccount.com
SLIPS_SQL_INSTANCE=your-project:northamerica-northeast1:your-instance
SLIPS_SQL_USER=mtl-slips-functions@your-project.iam
SLIPS_SQL_DATABASE=restaurant
SLIPS_REGION=northamerica-northeast1
SLIPS_BUCKET=your-project-order-slips
SLIPS_LLM_PROVIDER=vertex
SLIPS_VERTEX_LOCATION=northamerica-northeast1
SLIPS_VERTEX_REQUEST_TYPE=dedicated
SLIPS_OPENAI_MODEL=gpt-5.4-mini
SLIPS_OPENAI_SECRET=mtl-slips-openai
