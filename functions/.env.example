# Cloud only: IAM database authentication, no database password.
STAFF_SQL_INSTANCE=mtl-service-e3e0c:northamerica-northeast1:mtl-restaurant-dev
STAFF_SQL_USER=YOUR_FUNCTION_SERVICE_ACCOUNT_WITHOUT_GSERVICEACCOUNT_COM
STAFF_SQL_DATABASE=restaurant
STAFF_RUNTIME_SERVICE_ACCOUNT=YOUR_FUNCTION_SERVICE_ACCOUNT_EMAIL
# Local emulator tests only; set these in the shell (never use cloud credentials):
# GCLOUD_PROJECT=demo-mtl
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# STAFF_LOCAL_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/restaurant

# Native order creation (dedicated runtime identity; trusted setup uses separate grants).
ORDERS_SQL_INSTANCE=your-project:northamerica-northeast1:your-instance
ORDERS_SQL_DATABASE=restaurant
ORDERS_SQL_USER=your-orders-runtime-iam-login
ORDERS_RUNTIME_SERVICE_ACCOUNT=orders-runtime@your-project.iam.gserviceaccount.com
# Never set ORDERS_LOCAL_DATABASE_URL in cloud deployment configuration.
